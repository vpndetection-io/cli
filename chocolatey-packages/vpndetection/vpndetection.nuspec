    <owners>Mslm Dev</owners>
    <title>VPNDetection CLI</title>
    <authors>Mslm Dev</authors>
    <projectUrl>https://vpndetection.io</projectUrl>
    <iconUrl>https://s3.vpndetection.io/vpndetection-public/brand/mark.svg</iconUrl>
